{
  "name": "@composable-svelte/graphics",
  "version": "0.3.0",
  "description": "State-driven WebGL graphics package for Composable Svelte",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-package -i src -o dist && node ../../scripts/emit-svelte-declaration-bridges.mjs dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "check": "svelte-check --tsconfig ./tsconfig.test.json --fail-on-warnings",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run check && SILENT_TESTS=true pnpm test",
    "prepack": "pnpm run build",
    "test:browser": "vitest run --config graphics.browser.config.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "MANAGED.md",
    "fixtures/installed-consumer",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@composable-svelte/core": "^0.13.1",
    "svelte": "^5.20.0"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0"
  },
  "devDependencies": {
    "@babylonjs/inspector": "^8.0.0",
    "@composable-svelte/core": "workspace:*",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^22.0.0",
    "jsdom": "^25.0.1",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.3",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.7",
    "@vitest/browser-playwright": "^4.0.7",
    "playwright": "^1.56.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "license": "MIT",
  "author": "Jonathan Belolo",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanbelolo/composable-svelte.git",
    "directory": "packages/graphics"
  },
  "homepage": "https://github.com/jonathanbelolo/composable-svelte/tree/main/packages/graphics#readme",
  "bugs": {
    "url": "https://github.com/jonathanbelolo/composable-svelte/issues"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "webgl",
    "graphics",
    "3d",
    "babylonjs",
    "shaders",
    "composable-architecture",
    "typescript"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  }
}
