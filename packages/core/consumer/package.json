{
  "name": "composable-svelte-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:architecture": "composable-svelte-architecture --mode analysis-only --project . --policy bundled:starter --expected-core-version 0.13.1",
    "build": "vite build",
    "test": "vitest run",
    "test:browser": "playwright test --config playwright.config.ts && playwright test --config playwright.lifetime.config.ts",
    "test:ssr": "node scripts/ssr.mjs"
  },
  "dependencies": {
    "@composable-svelte/core": "0.13.1",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@composable-svelte/architecture": "0.13.1",
    "@playwright/test": "1.56.1",
    "@sveltejs/vite-plugin-svelte": "6.2.1",
    "@tailwindcss/vite": "4.1.13",
    "tailwindcss": "4.1.13",
    "@types/node": "22.18.6",
    "svelte-check": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.0.7"
  }
}
