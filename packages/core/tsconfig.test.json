{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "types": [
      "svelte",
      "node",
      "vitest/globals"
    ],
    "paths": {
      "@composable-svelte/core": [
        "./dist/index.d.ts"
      ],
      "@composable-svelte/core/test": [
        "./dist/test/index.d.ts"
      ],
      "@composable-svelte/core/components/ui": [
        "./dist/components/ui/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "consumer/src/**/*",
    "consumer/tests/**/*",
    "consumer/browser/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
