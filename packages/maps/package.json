{
  "name": "@composable-svelte/maps",
  "version": "0.4.0",
  "description": "Interactive map components for Composable Svelte - Built with Maplibre GL, with an optional Mapbox GL adapter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./mapbox": {
      "types": "./dist/mapbox/index.d.ts",
      "svelte": "./dist/mapbox/index.js",
      "default": "./dist/mapbox/index.js"
    }
  },
  "svelte": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "API.md",
    "MANAGED.md",
    "fixtures/installed-consumer",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "svelte-package -o dist && node ../../scripts/emit-svelte-declaration-bridges.mjs dist",
    "typecheck": "tsc --noEmit",
    "check": "svelte-check --tsconfig ./tsconfig.test.json --fail-on-warnings",
    "test": "vitest run",
    "test:browser": "vitest run --config maps.browser.config.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run check && SILENT_TESTS=true pnpm test",
    "prepack": "pnpm run build"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "maps",
    "maplibre",
    "interactive-maps",
    "geospatial",
    "gis",
    "composable-architecture",
    "typescript",
    "mapbox-optional"
  ],
  "author": "Jonathan Belolo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonathanbelolo/composable-svelte.git",
    "directory": "packages/maps"
  },
  "homepage": "https://github.com/jonathanbelolo/composable-svelte/tree/main/packages/maps#readme",
  "bugs": {
    "url": "https://github.com/jonathanbelolo/composable-svelte/issues"
  },
  "peerDependencies": {
    "@composable-svelte/core": "^0.14.0",
    "svelte": "^5.20.0",
    "mapbox-gl": "^3.0.0"
  },
  "devDependencies": {
    "@composable-svelte/core": "workspace:*",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^20.0.0",
    "@vitest/browser": "^4.0.7",
    "@vitest/browser-playwright": "^4.0.7",
    "@vitest/coverage-v8": "^4.0.7",
    "@vitest/ui": "^4.0.7",
    "jsdom": "^25.0.1",
    "mapbox-gl": "^3.16.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^6.4.1",
    "vitest": "^4.0.7"
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16",
    "maplibre-gl": "^4.7.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.svelte"
  ],
  "peerDependenciesMeta": {
    "mapbox-gl": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
