{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "paths": {
      "@composable-svelte/maps": ["."]
    },
    "types": [
      "svelte",
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "tests/**/*",
    "fixtures/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
