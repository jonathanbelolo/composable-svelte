{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM"],
    "strict": true, "skipLibCheck": true, "allowJs": true, "resolveJsonModule": true,
    "verbatimModuleSyntax": true, "esModuleInterop": true, "types": ["svelte"]
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"]
}
