# Vitest browser-mode failure screenshots — regenerated on every failing run,
# not baselines (nothing compares against them).
**/__screenshots__/

# Vite output that is not named `dist`, plus Playwright's run state. Both are
# regenerated by `pnpm -r build` / `pnpm test:e2e`, and the bundles are
# content-hashed — so committing them adds a new file per build rather than
# updating one.
dist-app/
test-results/
playwright-report/
