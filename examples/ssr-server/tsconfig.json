{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		// This project genuinely runs on Node — it is a Fastify server — so unlike
		// the browser-only examples it keeps `types`. The root sets `types: []`.
		"types": ["node", "vite/client"],
		"noEmit": true,
		"declaration": false,
		"declarationMap": false
	},
	"include": ["src/**/*.ts", "src/**/*.svelte"],
	"exclude": ["node_modules", "dist"]
}
